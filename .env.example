# Mints the receive endpoint accepts, comma separated. The first one is the
# mint the demo feed and both wallets use. Default: https://testnut.cashu.space
# NUTCAST_MINTS=https://testnut.cashu.space

# Public origin, if the app sits behind a proxy that hides it.
# NUTCAST_ORIGIN=https://nutcast.example.com

# Inbox storage on a serverless host (Upstash-style Redis REST API).
# Without these, the inbox is a file at .data/inbox.json.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# Set to off to disable loading other shows' feeds through this server.
# NUTCAST_FEED_PROXY=off
